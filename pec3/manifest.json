
{
  "manifest_version": 3,
  "name": "Reto_3",
  "version": "2.0",
  "description": "Agrega un icono para contar el tiempo que pasa desde un instante y otro. Desde start hata finish",
  "homepage_url": "https://mfuentesfailde.github.io/aplicaciones/Reloj/",
  "icons": {
    "32": "icons/reloj_32.png",
    "48": "icons/reloj_48.png"
  },
  "permissions": [

  ],
  "action": {
    "default_icon": "icons/reloj_32.png",
    "default_title": "CountTime",
    "default_popup": "popup/contador.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sol.png",
        "assets/luna.png",
        "assets/Dax.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
